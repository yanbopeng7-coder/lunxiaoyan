# 复制本文件为 .env 后填写；不要把真实密钥提交到 GitHub/Gitee
# 申请地址示例：智谱 https://open.bigmodel.cn ；通义 https://dashscope.console.aliyun.com

# 主用（默认智谱 GLM-4-Flash）
ZHIPU_API_KEY=在这里填入你的智谱 API Key

# 可选备用
SILICONFLOW_API_KEY=在这里填入硅基流动密钥（可选）
GROQ_API_KEY=在这里填入 Groq 密钥（可选）
DEEPSEEK_API_KEY=在这里填入 DeepSeek 密钥（可选）

# 通义千问（阿里云 DashScope，可选）
DASHSCOPE_API_KEY=在这里填入你的 dashscope 密钥
# QWEN_MODEL=qwen-turbo

# 其它可选厂商
MOONSHOT_API_KEY=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
SPARK_API_KEY=
